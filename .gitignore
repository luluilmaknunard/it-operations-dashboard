# ==========================================
# 1. RAHASIA & API KEYS (SANGAT PENTING!)
# ==========================================
# Menyembunyikan secrets/API keys Streamlit
.streamlit/secrets.toml
.streamlit/secrets*.toml

# File Environment Variable lainnya
.env
.env.*
*.env
*.pem
*.key
*.p12

# ==========================================
# 2. FILE DATA SENSITIF & CHUNK DATA
# ==========================================
# Sembunyikan file data lokal (Excel, CSV, Parquet) agar data tidak bocor
*.csv
*.xlsx
*.xls
*.parquet
*.json
*.sqlite
*.db

# Terpenuhi jika kamu punya folder khusus data (opsional, mengabaikan isi folder data)
data/
datasets/
temp/

# ==========================================
